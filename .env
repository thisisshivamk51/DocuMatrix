# Postgres
POSTGRES_USER=docuser
POSTGRES_PASSWORD=docpass
POSTGRES_DB=docdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docuser:docpass@postgres:5432/docdb

# App
UPLOAD_DIR=/uploads
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tiff
MAX_UPLOAD_SIZE=52428800

# OCR
TESSERACT_LANG=eng

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Placeholder for LLM API (if you add one)
LLM_API_KEY=
LLM_API_URL=
